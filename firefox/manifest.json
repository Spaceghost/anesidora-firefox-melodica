{
    "manifest_version": 2,
    "background": {
        "page": "background.htm"
    },
    "browser_action": {
        "browser_style": false,
        "default_icon": "images/anesidora-debug-128.png",
        "default_popup": "cozy.htm"
    },
    "description": "Tabs? Where we're listening, we don't need tabs.",
    "icons": {
        "128": "images/anesidora-debug-128.png",
        "16": "images/anesidora-debug-16.png",
        "48": "images/anesidora-debug-48.png"
    },
    "name": "Anesidora for Melodica",
    "homepage_url": "https://spacegho.st/melodica/apps/#anesidora-firefox",
    "permissions": [
        "declarativeNetRequest",
        "http://*.pandora.com/*",
        "https://*.pandora.com/*",
        "http://*.p-cdn.com/*",
        "https://*.p-cdn.com/*",
        "http://*.p-cdn.us/*",
        "https://*.p-cdn.us/*",
        "https://spacegho.st/*"
    ],
    "browser_specific_settings": {
        "gecko": {
            "id": "anesidora-melodica@spacegho.st",
            "data_collection_permissions": {
                "required": [
                    "authenticationInfo",
                    "personallyIdentifyingInfo",
                    "websiteActivity"
                ]
            }
        }
    },
    "commands": {
        "skip_back": {
            "description": "Skip back"
        },
        "pause_play": {
            "description": "Play/Pause"
        },
        "skip_song": {
            "description": "Skip forward"
        },
        "_execute_browser_action": {
            "description": "Open player popup",
            "suggested_key": {
                "default": "Ctrl+Space"
            }
        }
    },
    "declarative_net_request": {
        "rule_resources": [
            {
                "id": "ruleset",
                "enabled": true,
                "path": "declarativeNetRules.json"
            }
        ]
    },
    "version": "3.0.1",
    "options_ui": {
        "page": "options.htm"
    },
    "content_security_policy": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
}
